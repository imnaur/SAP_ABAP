managed implementation in class ZBP_R_FT05_CUSTOMERS unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_FT05_CUSTOMERS alias Customers
persistent table zft05_customers
extensible
draft table zft05_cstomers_d
etag master LastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( mandatory : create )
  Customerid;

  field ( readonly )
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt,
  City;

  field ( readonly : update )
  Customerid;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  determination GetPLZ on save
  {
    field postcode; }

  side effects
  {
    field postcode affects field city;
  }


  mapping for zft05_customers corresponding extensible
    {
      Customerid         = CUSTOMERID;
      Salutation         = SALUTATION;
      LastName           = LAST_NAME;
      FirstName          = FIRST_NAME;
      Street             = STREET;
      City               = CITY;
      County             = COUNTY;
      Postcode           = POSTCODE;
      LocalCreatedBy     = LOCAL_CREATED_BY;
      LocalCreatedAt     = LOCAL_CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }

}